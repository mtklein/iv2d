builddir = out

subninja rel.ninja
subninja dbg.ninja

rule run
    command = ./$in $args > $out

rule compare
    command = cmp -s $in > $out

build gold/slim_difference-0.png: run out/dbg/gold
    args = 2 0 600x402
build gold/slim_difference-1.png: run out/dbg/gold
    args = 2 1 600x402
build gold/slim_difference-3.png: run out/dbg/gold
    args = 2 3 600x402
