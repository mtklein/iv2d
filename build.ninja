builddir = out

subninja rel.ninja
subninja dbg.ninja

rule run
    command = ./$in $args > $out

build gold/slim_difference-0.png: run out/dbg/demo
    args = p 2 600x402
build gold/slim_difference-1.png: run out/dbg/demo
    args = p 2 600x402 +
build gold/slim_difference-3.png: run out/dbg/demo
    args = p 2 600x402 +++
build gold/slim_difference-5.png: run out/dbg/demo
    args = p 2 600x402 +++++

build gold/fat_difference-0.png: run out/dbg/demo
    args = p 2 800x600
build gold/fat_difference-1.png: run out/dbg/demo
    args = p 2 800x600 +
build gold/fat_difference-3.png: run out/dbg/demo
    args = p 2 800x600 +++
build gold/fat_difference-5.png: run out/dbg/demo
    args = p 2 800x600 +++++

build gold/capsule-0.png: run out/dbg/demo
    args = p 3 800x600
build gold/capsule-1.png: run out/dbg/demo
    args = p 3 800x600 +
build gold/capsule-3.png: run out/dbg/demo
    args = p 3 800x600 +++
build gold/capsule-5.png: run out/dbg/demo
    args = p 3 800x600 +++++

build gold/stroke-ngon-0.png: run out/dbg/demo
    args = p 5s 800x600
build gold/stroke-ngon-1.png: run out/dbg/demo
    args = p 5s 800x600 +
build gold/stroke-ngon-3.png: run out/dbg/demo
    args = p 5s 800x600 +++
build gold/stroke-ngon-5.png: run out/dbg/demo
    args = p 5s 800x600 +++++

build gold/union-0.png: run out/dbg/demo
    args = p 0 800x600
build gold/union-1.png: run out/dbg/demo
    args = p 0 800x600 +
build gold/union-3.png: run out/dbg/demo
    args = p 0 800x600 +++
build gold/union-5.png: run out/dbg/demo
    args = p 0 800x600 +++++

build gold/vm-union-0.png: run out/dbg/demo
    args = p 6 800x600
build gold/vm-union-1.png: run out/dbg/demo
    args = p 6 800x600 +
build gold/vm-union-3.png: run out/dbg/demo
    args = p 6 800x600 +++
build gold/vm-union-5.png: run out/dbg/demo
    args = p 6 800x600 +++++

build gold/helvetica-sdf-0.png: run out/dbg/demo
    args = p 8 800x600
build gold/helvetica-sdf-1.png: run out/dbg/demo
    args = p 8 800x600 +
build gold/helvetica-sdf-3.png: run out/dbg/demo
    args = p 8 800x600 +++
build gold/helvetica-sdf-5.png: run out/dbg/demo
    args = p 8 800x600 +++++
